# Hub (SSO próprio com JWT, Fastify) — ATENÇÃO: o Prisma ainda usa MySQL/MariaDB
# (prisma/schema.prisma, provider "mysql"). As aplicações migraram para o
# PostgreSQL em out/2026 e o login passou para o Authentik (auth.drogamais.com.br);
# confirmar com o dono se este app ainda está em uso antes de configurar.
#
# Ambiente de Teste/Dev com banco em container
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=dbBanco
DB_USER=usuario
DB_PASSWORD=senha

# Full connection URL for Prisma/clients
DATABASE_URL=mysql://usuario:senha@host.docker.internal:3306/dbBanco

JWT_SECRET=sid-drogamais-jwt-secret-2026-secure-sso
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
SUPER_ADMIN_EMAILS="ti@drogamais.com.br,inteligencia@drogamais.com.br"
ACCESS_TOKEN_EXPIRY="15m"
# Senha do super admin criado pelo prisma/seed.js (sem ela o seed usa um padrão fraco).
# SUPER_ADMIN_PASSWORD=
# Cookie do refresh token (padrões: localhost, lax, false).
# COOKIE_DOMAIN=
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

PORT=8003